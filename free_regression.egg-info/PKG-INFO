Segundo exemplo reduzindo a dimensionalidade:

```python
def s(x:float) -> float:
  return x

def f(x1, x2, x3, w1, w2, w3, w4, w5, w6, w7, w8, w9, w10, w11, w12, w13, w14, w15, w16, w17) -> (float, float, float):
  c11:float = s(x1*w1 + x2*w2 + x3*w3 + w16)
  c12:float = s(x1*w4 + x2*w5 + x3*w6 + w17)
  return [c11*w7 + c12*w8 + w13, c11*w9 + c12*w10 + w14, c11*w11 + c12*w12 + w15]

def f_parc(x1, x2, x3, w1, w2, w3, w4, w5, w6, w16, w17) -> (float, float):
  c11:float = s(x1*w1 + x2*w2 + x3*w3 + w16)
  c12:float = s(x1*w4 + x2*w5 + x3*w6 + w17)
  return [c11, c12]
  
################################################################

from random import random, seed
seed(1)

dados_1, dados_2, dados_3, dados_4, dados_5, dados_6, dados_7, dados_8 = [], [], [], [], [], [], [], []
n:int = 2
k:int = 10

for _ in range(k):
  temp = [random(), random(), random()]
  temp = [*temp, [temp[0] - 3, temp[1] - 3, temp[2] - 3]]
  dados_1.append(temp.copy())

for _ in range(k):
  temp = [random() + n, random(), random()]
  temp = [*temp, [temp[0] - 3, temp[1] - 3, temp[2] - 3]]
  dados_2.append(temp.copy())

for _ in range(k):
  temp = [random(), random() + n, random()]
  temp = [*temp, [temp[0] - 3, temp[1] - 3, temp[2] - 3]]
  dados_3.append(temp.copy())

for _ in range(k):
  temp = [random(), random(), random() + n]
  temp = [*temp, [temp[0] - 3, temp[1] - 3, temp[2] - 3]]
  dados_4.append(temp.copy())

for _ in range(k):
  temp = [random() + n, random() + n, random() + n]
  temp = [*temp, [temp[0] - 3, temp[1] - 3, temp[2] - 3]]
  dados_5.append(temp.copy())

for _ in range(k):
  temp = [random(), random() + n, random() + n]
  temp = [*temp, [temp[0] - 3, temp[1] - 3, temp[2] - 3]]
  dados_6.append(temp.copy())

for _ in range(k):
  temp = [random() + n, random(), random() + n]
  temp = [*temp, [temp[0] - 3, temp[1] - 3, temp[2] - 3]]
  dados_7.append(temp.copy())

for _ in range(k):
  temp = [random() + n, random() + n, random()]
  temp = [*temp, [temp[0] - 3, temp[1] - 3, temp[2] - 3]]
  dados_8.append(temp.copy())

dados = [*dados_1, *dados_2, *dados_3, *dados_4, *dados_5, *dados_6, *dados_7, *dados_8]
colors = [*["blue"] * k, *["red"] * k, *["green"] * k, *["grey"] * k, *["pink"] * k, *["yellow"] * k, *["black"] * k, *["purple"] * k]

################################################################

modelo = Regression(f, print = True)
modelo.set_seed(1)
print(modelo)

modelo.run(dados)
#modelo.run_robust(dados)
print(modelo)

################################################################

import matplotlib.pyplot as plt

modelo_parc = Regression(f_parc)
modelo_parc << modelo # Pasando os pesos para o modelo parcial que permite vizualizar em 2d
print(modelo_parc)

x, y = zip(*modelo_parc.prediction([x_[:3] for x_ in dados]))


plt.scatter(x, y, c = colors, alpha = 0.4, s = 100)

plt.title("Redução de dimensionalidade")
plt.xlabel("Eixo X")
plt.ylabel("Eixo Y")

plt.show()

################################################################

x, y, z = zip(*[x_[:3] for x_ in dados])

for a, b in [[0, 0], [0, 45], [0, 90], [45, 90], [90, 90]]:

  fig = plt.figure()
  ax = fig.add_subplot(111, projection='3d')

  ax.scatter(x, y, z, c = colors, s = 100, alpha = 0.4)
  ax.view_init(elev = a, azim = b)

  ax.set_title(f"Gráfico de Dispersão 3D ({a}, {b})")
  ax.set_xlabel("Eixo X")
  ax.set_ylabel("Eixo Y")
  ax.set_zlabel("Eixo Z")
```

